---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const [teamRes, sectionsRes] = await Promise.all([
  supabase.from('team_members').select('*').order('order_index'),
  supabase.from('page_sections').select('*').eq('section_key', 'echipa_head').single(),
]);

const team    = teamRes.data    || [];
const headSec = sectionsRes.data || {};
---

<Layout
  title="Echipa — Educația Schimbă Destine"
  description="Echipa Asociației Educația Schimbă Destine: Lamiita Purcaru, Silviu Purcaru, Mihaela Bunea, Andreea Pădureț, Alexandra Raduta, Carina Neagoe."
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="eyebrow"
      >{headSec.eyebrow || 'Pentru că doar împreună putem'}</span>
      <h1
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="heading"
      >{headSec.heading || 'Echipa noastră'}</h1>
      <p
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="subheading"
      >{headSec.subheading || 'Oameni care cred că educația schimbă destine — și care muncesc zilnic pentru ca asta să fie adevărat pentru cât mai mulți copii.'}</p>
    </div>
  </section>

  <section class="tight">
    <div class="container">
      <div class="team-grid" data-db-section-add="team_members">
        {team.map((m, i) => (
          <div class="member">
            <div class={`member-portrait ${String.fromCharCode(97 + (i % 6))}`}
              data-db-table="team_members" data-db-id={m.id} data-db-field="image_url"
              style="overflow:hidden;"
            >
              {m.image_url
                ? <img src={m.image_url} alt={m.name} style="width:100%;height:100%;object-fit:cover;" />
                : <div class="ph">Foto</div>
              }
            </div>
            <div class="member-body">
              <div class="member-role"
                data-db-table="team_members" data-db-id={m.id} data-db-field="role"
              >{m.role}</div>
              <h3 class="member-name"
                data-db-table="team_members" data-db-id={m.id} data-db-field="name"
              >{m.name}</h3>
              {m.bio && (
                <p style="font-size:13px;color:var(--ink-soft);margin:4px 0 0;"
                  data-db-table="team_members" data-db-id={m.id} data-db-field="bio"
                >{m.bio}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <div style="text-align:center;margin-top:64px">
        <h2 style="margin-bottom:12px">Vrei să ni te alături?</h2>
        <p style="color:var(--ink-soft);max-width:52ch;margin:0 auto 24px">
          Căutăm voluntari pentru mentorat, evenimente, comunicare, fotografiere
          și logistică. Orice talent e binevenit.
        </p>
        <a href="/contact" class="btn btn-primary">Aplică pentru voluntariat</a>
      </div>
    </div>
  </section>
</Layout>
