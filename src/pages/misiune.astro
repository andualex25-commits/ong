---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const [cardsRes, sectionsRes] = await Promise.all([
  supabase.from('mission_cards').select('*').order('order_index'),
  supabase.from('page_sections').select('*').in('section_key', ['misiune_head', 'misiune_involve']),
]);

const missionCards = cardsRes.data || [];
const sectionsArr = sectionsRes.data || [];
const sec: Record<string, any> = {};
for (const s of sectionsArr) sec[s.section_key] = s;

const headSec    = sec['misiune_head']    || {};
const involveSec = sec['misiune_involve'] || {};
---

<Layout
  title="Misiune — Educația Schimbă Destine"
  description="Cele 6 direcții ale Asociației Educația Schimbă Destine: asistență materială, sprijin emoțional, educație, dezvoltare comunitară, siguranță și incluziune."
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="eyebrow"
      >{headSec.eyebrow || 'Misiunea noastră'}</span>
      <h1
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="heading"
      >{headSec.heading || 'Șase direcții. Un singur obiectiv: copilul.'}</h1>
      <p
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="subheading"
      >{headSec.subheading || 'Ce facem, cum facem și de ce contează fiecare gest de sprijin.'}</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="mission-grid" data-db-section-add="mission_cards">
        {missionCards.map((card) => (
          <div class="mission-card">
            <div class="mission-num"
              data-db-table="mission_cards" data-db-id={card.id} data-db-field="number"
            >{String(card.number).padStart(2, '0')}</div>
            <h3 data-db-table="mission_cards" data-db-id={card.id} data-db-field="title">{card.title}</h3>
            <p data-db-table="mission_cards" data-db-id={card.id} data-db-field="description">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--bg-alt)">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"
          data-db-table="page_sections" data-db-id={involveSec.id} data-db-field="eyebrow"
        >{involveSec.eyebrow || 'Implică-te'}</span>
        <h2
          data-db-table="page_sections" data-db-id={involveSec.id} data-db-field="heading"
        >{involveSec.heading || 'Nu e nevoie doar de bani. E nevoie de tine.'}</h2>
      </div>
      <div class="involve-grid">
        <div class="involve">
          <div class="involve-icon">♥</div>
          <h3>Donează</h3>
          <p>Donație unică sau lunară, prin card, transfer bancar sau redirecționarea a 3,5% din impozit.</p>
          <a href="/doneaza" class="btn btn-dark btn-sm">Donează acum</a>
        </div>
        <div class="involve">
          <div class="involve-icon">✋</div>
          <h3>Voluntariază</h3>
          <p>Ore de meditație, evenimente, logistică, comunicare — orice talent e binevenit.</p>
          <a href="/contact" class="btn btn-dark btn-sm">Aplică →</a>
        </div>
        <div class="involve">
          <div class="involve-icon">↗</div>
          <h3>Distribuie</h3>
          <p>Spune mai departe. Un share poate aduce următorul donator sau voluntar.</p>
          <a href="#" id="share-btn" class="btn btn-dark btn-sm">Distribuie</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.getElementById('share-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      navigator.share?.({ title: 'Educația Schimbă Destine', url: location.origin });
    });
  </script>
</Layout>
