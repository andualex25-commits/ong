---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Edit Donează — Admin" description="Edit donate page content">
  <style>
    html, body { margin: 0; padding: 0; overflow: hidden; height: 100%; }
    #root { display: flex; flex-direction: column; height: 100vh; }
    #topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 20px; height: 52px; background: #1a1a2e; color: white;
      flex-shrink: 0; gap: 16px; z-index: 10;
    }
    #topbar a, #topbar button {
      color: white; text-decoration: none; font-size: 13px;
      padding: 6px 14px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.1); cursor: pointer; font-weight: 500;
      transition: background 0.15s;
    }
    #topbar a:hover, #topbar button:hover { background: rgba(255,255,255,0.2); }
    #topbar .title { flex: 1; font-size: 14px; font-weight: 600; letter-spacing: 0.3px; }
    #frameWrap { flex: 1; position: relative; overflow: hidden; }
    #siteFrame { width: 100%; height: 100%; border: none; display: block; }
    #loader {
      position: absolute; inset: 0; background: white;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; color: #999; z-index: 5;
    }
    .modal-bg {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.65); z-index: 2000;
      align-items: center; justify-content: center; padding: 20px;
    }
    .modal-bg.open { display: flex; }
    .modal-box {
      background: white; border-radius: 14px; padding: 32px;
      max-width: 560px; width: 100%; box-shadow: 0 24px 64px rgba(0,0,0,0.35);
      animation: pop 0.18s ease;
    }
    @keyframes pop { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .modal-box h2 { margin: 0 0 20px; font-size: 18px; }
    .modal-close { float: right; background: none; border: none; font-size: 22px; cursor: pointer; color: #aaa; line-height: 1; margin-top: -4px; }
    .modal-close:hover { color: #333; }
    .current-val {
      padding: 12px 16px; background: #f6f7ff; border-left: 4px solid #3366ff;
      border-radius: 6px; margin-bottom: 20px; font-size: 13px; color: #555;
      white-space: pre-wrap; word-break: break-word; max-height: 80px; overflow: hidden;
    }
    .modal-box label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 8px; color: #444; }
    .modal-box textarea {
      width: 100%; padding: 12px; border: 2px solid #3366ff;
      border-radius: 8px; box-sizing: border-box; min-height: 100px;
      font-family: inherit; font-size: 14px; resize: vertical; line-height: 1.5;
    }
    .modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
    .btn-cancel { padding: 12px; background: #f0f0f0; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px; }
    .btn-save { padding: 12px; background: #3366ff; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px; }
    .msg { padding: 10px 14px; border-radius: 6px; font-size: 13px; margin-top: 12px; display: none; }

    /* btn modal */
    .add-field label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 6px; color: #444; }
    .add-field input { width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 7px; font-size: 14px; box-sizing: border-box; }
    .add-field small { display: block; font-size: 11px; color: #999; margin-bottom: 6px; }
    .btn-delete { padding: 12px 14px; background: #fdecea; color: #b33; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 13px; }
    .btn-delete:hover { background: #f5c6c6; }
  </style>

  <div id="root">
    <div id="topbar">
      <a href="/admin/dashboard">← Dashboard</a>
      <span class="title">✏️ Editează Donează — apasă pe orice text albastru</span>
      <a href="/doneaza" target="_blank">Vizualizează live ↗</a>
    </div>
    <div id="frameWrap">
      <div id="loader">Se încarcă previzualizarea...</div>
      <iframe id="siteFrame" src="/doneaza"></iframe>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="editModal" class="modal-bg">
    <div class="modal-box">
      <button class="modal-close" id="editClose">✕</button>
      <h2 id="editTitle">Editează</h2>
      <div class="current-val" id="editCurrent"></div>
      <label id="editLabel">Valoare nouă</label>
      <textarea id="editField"></textarea>
      <div class="msg" id="editMsg"></div>
      <div class="modal-actions">
        <button class="btn-cancel" id="editCancel">Anulează</button>
        <button class="btn-save" id="editSave">Salvează ✓</button>
      </div>
    </div>
  </div>

  <!-- Button Modal -->
  <div id="btnModal" class="modal-bg">
    <div class="modal-box" style="max-width:480px;">
      <button class="modal-close" id="btnClose">✕</button>
      <h2>Editează buton</h2>
      <div class="add-field">
        <label for="btnText">Text buton *</label>
        <input id="btnText" type="text" placeholder="ex: Completează formularul 230 →" />
      </div>
      <div class="add-field" style="margin-top:14px;">
        <label for="btnLink">Link (URL)</label>
        <small>ex: /doneaza sau https://...</small>
        <input id="btnLink" type="text" placeholder="https://..." />
      </div>
      <div class="msg" id="btnMsg"></div>
      <div class="modal-actions" style="margin-top:20px;grid-template-columns:auto 1fr 1fr;">
        <button class="btn-delete" id="btnDelete">🗑 Șterge</button>
        <button class="btn-cancel" id="btnCancel">Anulează</button>
        <button class="btn-save" id="btnSave">Salvează ✓</button>
      </div>
    </div>
  </div>

  <script>
    const authToken = localStorage.getItem('supabase.auth.token');
    if (!authToken) window.location.href = '/admin/login';

    const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
    const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    function getToken() { return JSON.parse(authToken).access_token; }

    async function dbPatch(table, id, body) {
      const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?id=eq.${id}`, {
        method: 'PATCH',
        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${getToken()}`, 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!r.ok && r.status !== 204) { const e = await r.json(); throw new Error(e.message || `HTTP ${r.status}`); }
    }

    const frame = document.getElementById('siteFrame');
    const loader = document.getElementById('loader');
    let editState = { table: null, id: null, field: null };
    let btnState  = { table: null, id: null, textField: null, linkField: null };

    frame.addEventListener('load', () => {
      const doc = frame.contentDocument;
      if (!doc || doc.body === null) return;
      loader.style.display = 'none';

      doc.addEventListener('click', (e) => {
        const a = e.target.closest('a');
        if (a && !a.hasAttribute('data-db-table')) e.preventDefault();
      }, true);

      injectAdminStyles(doc);
      injectAdminBar(doc);
      injectEditHandlers(doc);
    });

    function injectAdminStyles(doc) {
      const s = doc.createElement('style');
      s.textContent = `
        [data-db-table] {
          cursor: pointer !important;
          outline: 2px dashed transparent;
          outline-offset: 3px;
          transition: outline-color 0.12s, background 0.12s;
          border-radius: 3px;
        }
        [data-db-table]:hover {
          outline-color: #3366ff !important;
          background: rgba(51,102,255,0.07) !important;
        }
        .admin-bar {
          position: sticky; top: 0; z-index: 9999;
          background: #1a1a2e; color: white;
          text-align: center; padding: 9px 16px;
          font-size: 12px; font-weight: 500; letter-spacing: 0.3px;
        }
        .admin-bar span { opacity: 0.7; }
        /* Disable the donate form interactions */
        #donate-btn, .donate-tab, .amount, #custom-amount, #donor-email {
          pointer-events: none !important; opacity: 0.5 !important;
        }
      `;
      doc.head.appendChild(s);
    }

    function injectAdminBar(doc) {
      const bar = doc.createElement('div');
      bar.className = 'admin-bar';
      bar.innerHTML = '✏️ MOD EDITARE &nbsp;·&nbsp; <span>apasă pe orice text subliniat cu albastru pentru a-l edita · formularul de plată e dezactivat în preview</span>';
      doc.body.prepend(bar);
    }

    function injectEditHandlers(doc) {
      doc.querySelectorAll('[data-db-table]').forEach(el => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const { dbTable, dbId, dbField } = el.dataset;

          if (dbField === 'cta_primary_text') {
            const linkField = 'cta_primary_link';
            const currentLink = el.getAttribute('href') || '';
            openBtnModal(dbTable, dbId, dbField, linkField, el.textContent.trim(), currentLink);
          } else {
            openEditModal(dbTable, dbId, dbField, el.textContent.trim());
          }
        });
      });
    }

    // ── Edit Modal ──
    function openEditModal(table, id, field, currentVal) {
      editState = { table, id, field };
      const labels = {
        eyebrow: 'Eyebrow (text mic)', heading: 'Titlu', subheading: 'Subtitlu / descriere',
        stat1_label: 'Bullet 1', stat2_label: 'Bullet 2', stat3_label: 'Bullet 3', stat4_label: 'Bullet 4',
      };
      document.getElementById('editTitle').textContent = `Editează: ${labels[field] || field}`;
      document.getElementById('editCurrent').textContent = currentVal || '(gol)';
      document.getElementById('editField').value = currentVal || '';
      showMsg('editMsg', '', '');
      document.getElementById('editModal').classList.add('open');
      setTimeout(() => document.getElementById('editField').focus(), 80);
    }

    function closeEditModal() { document.getElementById('editModal').classList.remove('open'); }
    document.getElementById('editClose').onclick = closeEditModal;
    document.getElementById('editCancel').onclick = closeEditModal;
    document.getElementById('editModal').onclick = (e) => { if (e.target === document.getElementById('editModal')) closeEditModal(); };

    document.getElementById('editSave').onclick = async () => {
      const { table, id, field } = editState;
      const val = document.getElementById('editField').value;
      showMsg('editMsg', 'Se salvează...', 'info');
      try {
        await dbPatch(table, id, { [field]: val });
        showMsg('editMsg', '✓ Salvat! Se reîncarcă...', 'ok');
        setTimeout(() => { closeEditModal(); reloadFrame(); }, 900);
      } catch(e) {
        showMsg('editMsg', 'Eroare: ' + e.message, 'err');
      }
    };

    // ── Button Modal ──
    function openBtnModal(table, id, textField, linkField, currentText, currentLink) {
      btnState = { table, id, textField, linkField };
      document.getElementById('btnText').value = currentText || '';
      document.getElementById('btnLink').value = currentLink || '';
      showMsg('btnMsg', '', '');
      document.getElementById('btnModal').classList.add('open');
      setTimeout(() => document.getElementById('btnText').focus(), 80);
    }

    function closeBtnModal() { document.getElementById('btnModal').classList.remove('open'); }
    document.getElementById('btnClose').onclick = closeBtnModal;
    document.getElementById('btnCancel').onclick = closeBtnModal;
    document.getElementById('btnModal').onclick = (e) => { if (e.target === document.getElementById('btnModal')) closeBtnModal(); };

    document.getElementById('btnSave').onclick = async () => {
      const { table, id, textField, linkField } = btnState;
      const text = document.getElementById('btnText').value.trim();
      const link = document.getElementById('btnLink').value.trim();
      if (!text) { showMsg('btnMsg', 'Textul butonului nu poate fi gol.', 'err'); return; }
      showMsg('btnMsg', 'Se salvează...', 'info');
      try {
        await dbPatch(table, id, { [textField]: text, [linkField]: link || null });
        showMsg('btnMsg', '✓ Salvat! Se reîncarcă...', 'ok');
        setTimeout(() => { closeBtnModal(); reloadFrame(); }, 900);
      } catch(e) {
        showMsg('btnMsg', 'Eroare: ' + e.message, 'err');
      }
    };

    document.getElementById('btnDelete').onclick = async () => {
      const { table, id, textField, linkField } = btnState;
      if (!confirm('Ștergi butonul?')) return;
      showMsg('btnMsg', 'Se șterge...', 'info');
      try {
        await dbPatch(table, id, { [textField]: '', [linkField]: '' });
        showMsg('btnMsg', '✓ Șters! Se reîncarcă...', 'ok');
        setTimeout(() => { closeBtnModal(); reloadFrame(); }, 900);
      } catch(e) {
        showMsg('btnMsg', 'Eroare: ' + e.message, 'err');
      }
    };

    function reloadFrame() {
      loader.style.display = 'flex';
      frame.src = '/doneaza';
    }

    function showMsg(id, text, type) {
      const el = document.getElementById(id);
      if (!text) { el.style.display = 'none'; return; }
      el.style.display = 'block';
      el.style.background = type === 'ok' ? '#edfaed' : type === 'err' ? '#fdecea' : '#eef0ff';
      el.style.color = type === 'ok' ? '#276' : type === 'err' ? '#b33' : '#335';
      el.textContent = text;
    }
  </script>
</Layout>