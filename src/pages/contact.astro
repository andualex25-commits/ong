---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const [sectionsRes, contactRes] = await Promise.all([
  supabase.from('page_sections').select('*').eq('section_key', 'contact_head').single(),
  supabase.from('contact_info').select('*'),
]);

const headSec = sectionsRes.data || {};
const contactArr = contactRes.data || [];
const ci: Record<string, any> = {};
for (const row of contactArr) ci[row.key] = row;
---

<Layout
  title="Contact — Educația Schimbă Destine"
  description="Contactează Asociația Educația Schimbă Destine. Email, telefon, adresă și formular de contact."
>
  <!-- ══ PAGE HEADER ══════════════════════════════════════════════════════════ -->
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="eyebrow"
      >{headSec.eyebrow || 'Contact'}</span>
      <h1
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="heading"
      >{headSec.heading || 'Suntem aici pentru tine'}</h1>
      <p
        data-db-table="page_sections" data-db-id={headSec.id} data-db-field="subheading"
      >{headSec.subheading || 'Ai o întrebare, vrei să te implici sau să donezi? Scrie-ne sau sună-ne — răspundem în aceeași zi.'}</p>
    </div>
  </section>

  <!-- ══ CONTACT GRID ═══════════════════════════════════════════════════════ -->
  <section>
    <div class="container">
      <div class="contact-grid">

        <!-- INFO CARDS -->
        <div class="contact-info-col">
          <div class="contact-card">
            <div class="contact-icon">@</div>
            <div>
              <div class="contact-label">Email</div>
              <a href={`mailto:${ci.email?.value || 'educatiaschimbadestine@gmail.com'}`}
                class="contact-value"
                data-db-table="contact_info" data-db-id={ci.email?.id} data-db-field="value"
              >{ci.email?.value || 'educatiaschimbadestine@gmail.com'}</a>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-icon">☎</div>
            <div>
              <div class="contact-label">Telefon</div>
              <a href={`tel:${(ci.telefon?.value || '').replace(/\s/g,'')}`}
                class="contact-value"
                data-db-table="contact_info" data-db-id={ci.telefon?.id} data-db-field="value"
              >{ci.telefon?.value || '0721 314 855'}</a>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-icon">⌖</div>
            <div>
              <div class="contact-label">Adresă</div>
              <span class="contact-value"
                data-db-table="contact_info" data-db-id={ci.adresa?.id} data-db-field="value"
              >{ci.adresa?.value || 'București, România'}</span>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-icon">◷</div>
            <div>
              <div class="contact-label">Program</div>
              <span class="contact-value"
                data-db-table="contact_info" data-db-id={ci.program?.id} data-db-field="value"
              >{ci.program?.value || 'Luni–Vineri, 10:00–18:00'}</span>
            </div>
          </div>

          <!-- Social links -->
          <div class="contact-social">
            {ci.facebook?.value && ci.facebook.value !== 'https://facebook.com' && (
              <a href={ci.facebook.value} target="_blank" rel="noopener"
                data-db-table="contact_info" data-db-id={ci.facebook?.id} data-db-field="value"
                class="social-link"
              >Facebook →</a>
            )}
            {ci.instagram?.value && ci.instagram.value !== 'https://instagram.com' && (
              <a href={ci.instagram.value} target="_blank" rel="noopener"
                data-db-table="contact_info" data-db-id={ci.instagram?.id} data-db-field="value"
                class="social-link"
              >Instagram →</a>
            )}
          </div>

          <!-- IBAN + CIF -->
          <div class="contact-legal">
            <div>
              <span class="contact-label">IBAN</span>
              <span class="contact-mono"
                data-db-table="contact_info" data-db-id={ci.iban?.id} data-db-field="value"
              >{ci.iban?.value || 'RO30 RZBR 0000 0600 2578 2550'}</span>
            </div>
            <div>
              <span class="contact-label">CIF</span>
              <span
                data-db-table="contact_info" data-db-id={ci.cif?.id} data-db-field="value"
              >{ci.cif?.value || '49395736'}</span>
            </div>
          </div>
        </div>

        <!-- CONTACT FORM -->
        <div class="contact-form-col">
          <h2 class="contact-form-title">Trimite-ne un mesaj</h2>
          <form class="contact-form" id="contactForm">
            <div class="form-group">
              <label for="cf-name">Nume complet</label>
              <input id="cf-name" type="text" placeholder="Ion Popescu" required />
            </div>
            <div class="form-group">
              <label for="cf-email">Email</label>
              <input id="cf-email" type="email" placeholder="ion@exemplu.ro" required />
            </div>
            <div class="form-group">
              <label for="cf-subject">Subiect</label>
              <select id="cf-subject">
                <option value="voluntariat">Vreau să fiu voluntar</option>
                <option value="donatie">Informații donații</option>
                <option value="parteneriat">Parteneriat / sponsorizare</option>
                <option value="altele">Altele</option>
              </select>
            </div>
            <div class="form-group">
              <label for="cf-message">Mesaj</label>
              <textarea id="cf-message" rows="5" placeholder="Scrie mesajul tău..." required></textarea>
            </div>
            <div id="cf-error" class="form-error" style="display:none"></div>
            <div id="cf-success" class="form-success" style="display:none">
              Mesajul a fost trimis! Te contactăm în curând.
            </div>
            <button type="submit" class="btn btn-primary" id="cf-submit">Trimite mesajul</button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <script define:vars={{ contactEmail: ci.email?.value || 'educatiaschimbadestine@gmail.com' }}>
    const form = document.getElementById('contactForm');
    const errorEl = document.getElementById('cf-error');
    const successEl = document.getElementById('cf-success');
    const submitBtn = document.getElementById('cf-submit');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name    = (document.getElementById('cf-name') as HTMLInputElement).value.trim();
      const email   = (document.getElementById('cf-email') as HTMLInputElement).value.trim();
      const subject = (document.getElementById('cf-subject') as HTMLSelectElement).value;
      const message = (document.getElementById('cf-message') as HTMLTextAreaElement).value.trim();

      if (!name || !email || !message) {
        errorEl.style.display = 'block';
        errorEl.textContent = 'Te rugăm să completezi toate câmpurile.';
        return;
      }

      const subjectMap: Record<string, string> = {
        voluntariat: 'Voluntariat',
        donatie: 'Informații donații',
        parteneriat: 'Parteneriat / sponsorizare',
        altele: 'Mesaj',
      };

      const mailtoSubject = encodeURIComponent(`[ESD] ${subjectMap[subject] || 'Mesaj'} — ${name}`);
      const mailtoBody = encodeURIComponent(
        `Nume: ${name}\nEmail: ${email}\n\n${message}`
      );

      window.location.href = `mailto:${contactEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;

      successEl.style.display = 'block';
      errorEl.style.display = 'none';
      (submitBtn as HTMLButtonElement).disabled = true;
    });
  </script>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  .contact-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--ink-hairline, #eee);
  }
  .contact-card:last-of-type { border-bottom: none; }
  .contact-icon {
    width: 2.4rem;
    height: 2.4rem;
    background: var(--green, #2d6a4f);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .contact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--ink-soft, #888);
    margin-bottom: 2px;
  }
  .contact-value {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink, #1a1a1a);
    text-decoration: none;
  }
  a.contact-value:hover { text-decoration: underline; }

  .contact-social {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
  }
  .social-link {
    font-weight: 600;
    color: var(--green, #2d6a4f);
    text-decoration: none;
  }
  .social-link:hover { text-decoration: underline; }

  .contact-legal {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    padding: 1rem 1.25rem;
    background: var(--surface, #f8f8f5);
    border-radius: var(--radius, 12px);
    margin-top: .5rem;
  }
  .contact-legal > div { display: flex; flex-direction: column; gap: 2px; }
  .contact-mono {
    font-family: monospace;
    font-size: 0.85rem;
    letter-spacing: .04em;
  }

  /* Form */
  .contact-form-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .contact-form { display: flex; flex-direction: column; gap: 1.1rem; }
  .form-group { display: flex; flex-direction: column; gap: .4rem; }
  .form-group label { font-size: .875rem; font-weight: 600; }
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: .65rem .9rem;
    border: 1.5px solid var(--ink-hairline, #ddd);
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    background: #fff;
    transition: border-color .15s;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--green, #2d6a4f);
  }
  .form-group textarea { resize: vertical; }
  .form-error { color: #c0392b; font-size: .875rem; }
  .form-success {
    color: var(--green, #2d6a4f);
    font-size: .9rem;
    font-weight: 600;
    padding: .75rem 1rem;
    background: #f0faf5;
    border-radius: 8px;
  }
</style>