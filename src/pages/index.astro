---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const [heroRes, heroStatsRes, partnerRes, projectRes, cardsRes, storiesRes, founderRes, sectionsRes] = await Promise.all([
  supabase.from('hero_content').select('*').eq('page', 'home').single(),
  supabase.from('hero_stats').select('*').order('order_index'),
  supabase.from('partner_logos').select('*').order('order_index'),
  supabase.from('featured_projects').select('*').order('order_index').limit(1),
  supabase.from('mission_cards').select('*').order('order_index'),
  supabase.from('beneficiary_stories').select('*').order('order_index'),
  supabase.from('founder_story').select('*').single(),
  supabase.from('page_sections').select('*'),
]);

const hero = heroRes.data;
const heroStats = heroStatsRes.data || [];
const partners = partnerRes.data || [];
const project = projectRes.data?.[0];
const missionCards = cardsRes.data || [];
const stories = storiesRes.data || [];
const founder = founderRes.data;

const sectionsArr = sectionsRes.data || [];
const sections: Record<string, any> = {};
for (const s of sectionsArr) sections[s.section_key] = s;

const mission   = sections['home_mission']      || {};
const storiesSec = sections['home_stories']     || {};
const donateSec  = sections['home_donate']      || {};
const founderSec = sections['home_founder']     || {};
const partnerSec = sections['home_partners']    || {};
---

<Layout title="Educația Schimbă Destine — ONG pentru copii vulnerabili">

  <!-- ══ HERO ══════════════════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow"
          data-db-table="hero_content" data-db-id={hero?.id} data-db-field="eyebrow"
        >{hero?.eyebrow || 'Copii · Educație · Comunitate'}</span>
        <h1
          data-db-table="hero_content" data-db-id={hero?.id} data-db-field="title"
        >{hero?.title || 'Pentru că doar împreună putem.'}</h1>
        <p class="lede"
          data-db-table="hero_content" data-db-id={hero?.id} data-db-field="description"
        >{hero?.description || 'Sprijinim copiii din medii vulnerabile din România cu rechizite, burse, hrană și mentorat — pentru că un copil care învață astăzi are mâine o șansă reală să iasă din sărăcie.'}</p>
        <div class="hero-cta">
          {hero?.cta_primary_text && (
            <a href={hero.cta_primary_link || '/doneaza'} class="btn btn-primary"
              data-db-table="hero_content" data-db-id={hero?.id} data-db-field="cta_primary_text"
            >{hero.cta_primary_text}</a>
          )}
          {hero?.cta_secondary_text && (
            <a href={hero.cta_secondary_link || '/proiecte'} class="btn btn-ghost"
              data-db-table="hero_content" data-db-id={hero?.id} data-db-field="cta_secondary_text"
            >{hero.cta_secondary_text}</a>
          )}
        </div>
        <div class="hero-stats">
          {heroStats.length > 0 ? heroStats.map(stat => (
            <div class="stat">
              <div class="num" data-db-table="hero_stats" data-db-id={stat.id} data-db-field="stat_number">{stat.stat_number}</div>
              <div class="label" data-db-table="hero_stats" data-db-id={stat.id} data-db-field="stat_label">{stat.stat_label}</div>
            </div>
          )) : (
            <>
              <div class="stat"><div class="num">120+</div><div class="label">copii sprijiniți</div></div>
              <div class="stat"><div class="num">6</div><div class="label">direcții active</div></div>
              <div class="stat"><div class="num">2024</div><div class="label">anul înființării</div></div>
            </>
          )}
        </div>
      </div>
      <div class="hero-image"
        data-db-table="hero_content" data-db-id={hero?.id} data-db-field="image_url"
      >
        {hero?.image_url
          ? <img src={hero.image_url} alt={hero.image_alt || ''} style="width:100%;height:100%;object-fit:cover;border-radius:12px;" />
          : <div class="ph">Înlocuiește cu foto autentică<br>(ex: copil la Hubul Călătoria Cunoașterii)</div>
        }
        <div class="hero-badge">
          <div class="hero-badge-icon">★</div>
          <div class="hero-badge-text">
            <strong data-db-table="hero_content" data-db-id={hero?.id} data-db-field="badge_title"
            >{hero?.badge_title || 'Proiect nou deschis'}</strong>
            <span data-db-table="hero_content" data-db-id={hero?.id} data-db-field="badge_description"
            >{hero?.badge_description || 'Călătoria Cunoașterii · Dâmbovița'}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ PARTENERI ═════════════════════════════════════════════════════════ -->
  <section class="partners tight">
    <div class="container">
      <div class="partners-row">
        <span class="partners-label"
          data-db-table="page_sections" data-db-id={partnerSec.id} data-db-field="eyebrow"
        >{partnerSec.eyebrow || 'Susținuți de'}</span>
        {partners.length > 0 ? partners.map(p => (
          <div class="partner-logo"
            data-db-table="partner_logos" data-db-id={p.id} data-db-field="name"
          >{p.name}</div>
        )) : (
          <>
            <div class="partner-logo">Partener 1</div>
            <div class="partner-logo">Partener 2</div>
            <div class="partner-logo">Partener 3</div>
            <div class="partner-logo">Partener 4</div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- ══ PROIECT FEATURED ═══════════════════════════════════════════════════ -->
  {project && (
  <section>
    <div class="container">
      <div class="project">
        <div>
          <span class="eyebrow"
            data-db-table="featured_projects" data-db-id={project.id} data-db-field="eyebrow"
          >{project.eyebrow || 'Proiect pilot'}</span>
          <h2 data-db-table="featured_projects" data-db-id={project.id} data-db-field="title">{project.title}</h2>
          <p data-db-table="featured_projects" data-db-id={project.id} data-db-field="description">{project.description}</p>
          <div class="project-meta">
            {project.location && <div><strong data-db-table="featured_projects" data-db-id={project.id} data-db-field="location">{project.location}</strong><span style="opacity:.7">locație</span></div>}
            {project.target_age && <div><strong data-db-table="featured_projects" data-db-id={project.id} data-db-field="target_age">{project.target_age}</strong><span style="opacity:.7">beneficiari</span></div>}
            {project.status && <div><strong data-db-table="featured_projects" data-db-id={project.id} data-db-field="status">{project.status}</strong><span style="opacity:.7">deschis</span></div>}
          </div>
          <div class="hero-cta">
            {project.cta_primary_text && (
              <a href={project.cta_primary_link || '/doneaza'} class="btn btn-primary"
                data-db-table="featured_projects" data-db-id={project.id} data-db-field="cta_primary_text"
              >{project.cta_primary_text}</a>
            )}
            {project.cta_secondary_text && (
              <a href={project.cta_secondary_link || '/proiecte'} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,0.4)"
                data-db-table="featured_projects" data-db-id={project.id} data-db-field="cta_secondary_text"
              >{project.cta_secondary_text}</a>
            )}
          </div>
        </div>
        <div class="project-image"
          data-db-table="featured_projects" data-db-id={project.id} data-db-field="image_url"
        >
          {project.image_url
            ? <img src={project.image_url} alt={project.image_alt || project.title} style="width:100%;height:100%;object-fit:cover;border-radius:12px;" />
            : <div class="ph">Foto: {project.title}</div>
          }
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- ══ MISIUNE ════════════════════════════════════════════════════════════ -->
  <section style="background:var(--bg-alt)">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"
          data-db-table="page_sections" data-db-id={mission.id} data-db-field="eyebrow"
        >{mission.eyebrow || 'Misiunea noastră'}</span>
        <h2 data-db-table="page_sections" data-db-id={mission.id} data-db-field="heading"
        >{mission.heading || 'Șase direcții. Un singur obiectiv: copilul.'}</h2>
        <p data-db-table="page_sections" data-db-id={mission.id} data-db-field="subheading"
        >{mission.subheading || 'Acționăm direct, fără intermediari, în comunitățile unde nevoia e cea mai mare.'}</p>
      </div>
      <div class="mission-grid" data-db-section-add="mission_cards">
        {missionCards.map((card) => (
          <div class="mission-card">
            <div class="mission-num">{String(card.number).padStart(2, '0')}</div>
            <h3 data-db-table="mission_cards" data-db-id={card.id} data-db-field="title">{card.title}</h3>
            <p data-db-table="mission_cards" data-db-id={card.id} data-db-field="description">{card.description}</p>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:48px">
        <a href={mission.cta_primary_link || '/misiune'} class="btn btn-ghost"
          data-db-table="page_sections" data-db-id={mission.id} data-db-field="cta_primary_text"
        >{mission.cta_primary_text || 'Citește tot despre misiune →'}</a>
      </div>
    </div>
  </section>

  <!-- ══ POVEȘTI ════════════════════════════════════════════════════════════ -->
  <section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"
          data-db-table="page_sections" data-db-id={storiesSec.id} data-db-field="eyebrow"
        >{storiesSec.eyebrow || 'Poveștile beneficiarilor'}</span>
        <h2 data-db-table="page_sections" data-db-id={storiesSec.id} data-db-field="heading"
        >{storiesSec.heading || 'Fiecare donație are un nume și un chip.'}</h2>
        <p data-db-table="page_sections" data-db-id={storiesSec.id} data-db-field="subheading"
        >{storiesSec.subheading || 'Sunt copii și familii reale pe care le sprijinim chiar acum.'}</p>
      </div>
      <div class="stories" data-db-section-add="beneficiary_stories">
        {stories.map((story, i) => (
          <article class="story">
            <div class={`story-image ${String.fromCharCode(97 + i)}`}
              data-db-table="beneficiary_stories" data-db-id={story.id} data-db-field="image_url"
              style={`--img-pos:${story.image_position || 'top'}`}
            >
              {story.image_url
                ? <img src={story.image_url} alt={story.image_alt || story.title} style="width:100%;height:100%;object-fit:cover;" />
                : <div class="ph">Foto: {story.title}</div>
              }
            </div>
            <div class="story-body">
              {story.tag && (
                <span class="story-tag"
                  data-db-table="beneficiary_stories" data-db-id={story.id} data-db-field="tag"
                >{story.tag}</span>
              )}
              <h3 data-db-table="beneficiary_stories" data-db-id={story.id} data-db-field="title">{story.title}</h3>
              <p data-db-table="beneficiary_stories" data-db-id={story.id} data-db-field="description">{story.description}</p>
              <a href={storiesSec.cta_primary_link || '/doneaza'} class="btn btn-dark btn-sm"
                data-db-table="page_sections" data-db-id={storiesSec.id} data-db-field="cta_primary_text"
              >{storiesSec.cta_primary_text || 'Susține'}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ FONDATOARE ═════════════════════════════════════════════════════════ -->
  {founder && (
  <section>
    <div class="container">
      <div class="founder">
        <div class="founder-portrait"
          data-db-table="founder_story" data-db-id={founder.id} data-db-field="image_url"
        >
          {founder.image_url
            ? <img src={founder.image_url} alt={founder.image_alt || founder.author_name || 'Lamiita Purcaru'} style="width:100%;height:100%;object-fit:cover;border-radius:8px;" />
            : <div class="ph">{founder.author_name || 'Lamiita Purcaru'}<br>(foto)</div>
          }
        </div>
        <div>
          <span class="eyebrow"
            data-db-table="founder_story" data-db-id={founder.id} data-db-field="eyebrow"
          >{founder.eyebrow || 'Povestea din spatele asociației'}</span>
          <blockquote>„<span
            data-db-table="founder_story" data-db-id={founder.id} data-db-field="quote"
          >{founder.quote || 'Pe mine educația m-a salvat.'}</span>"</blockquote>
          {founder.description && (
            <p>{founder.description.length > 400 ? founder.description.slice(0, 400).trimEnd() + '…' : founder.description}</p>
          )}
          <p class="founder-author">
            <span data-db-table="founder_story" data-db-id={founder.id} data-db-field="author_name"
            >{founder.author_name || 'Lamiita Purcaru'}</span>
            <small data-db-table="founder_story" data-db-id={founder.id} data-db-field="author_title"
            >{founder.author_title || 'Președinte & Fondatoare'}</small>
          </p>
          <a href={founderSec.cta_primary_link || '/despre'} class="btn btn-ghost btn-sm"
            data-db-table="page_sections" data-db-id={founderSec.id} data-db-field="cta_primary_text"
          >{founderSec.cta_primary_text || 'Citește povestea completă →'}</a>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- ══ DONEAZĂ ════════════════════════════════════════════════════════════ -->
  <section style="background:var(--bg-alt)">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"
          data-db-table="page_sections" data-db-id={donateSec.id} data-db-field="eyebrow"
        >{donateSec.eyebrow || 'Donează'}</span>
        <h2 data-db-table="page_sections" data-db-id={donateSec.id} data-db-field="heading"
        >{donateSec.heading || 'Transformă o viață cu o donație.'}</h2>
        <p data-db-table="page_sections" data-db-id={donateSec.id} data-db-field="subheading"
        >{donateSec.subheading || '100% din donație merge direct către copii. Donație unică, lunară sau prin redirecționarea a 3,5% din impozit.'}</p>
      </div>
      <div style="text-align:center">
        <a href={donateSec.cta_primary_link || '/doneaza'} class="btn btn-primary"
          data-db-table="page_sections" data-db-id={donateSec.id} data-db-field="cta_primary_text"
        >{donateSec.cta_primary_text || 'Donează acum'}</a>
        <a href={donateSec.cta_secondary_link || '/doneaza#redirect'} class="btn btn-ghost" style="margin-left:8px"
          data-db-table="page_sections" data-db-id={donateSec.id} data-db-field="cta_secondary_text"
        >{donateSec.cta_secondary_text || 'Redirect 3,5%'}</a>
      </div>
    </div>
  </section>


</Layout>
