---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: sectionsArr } = await supabase.from('page_sections').select('*').in('section_key', [
  'doneaza_head', 'doneaza_side', 'doneaza_redirect', 'doneaza_transfer', 'doneaza_amounts',
]);
const sec: Record<string, any> = {};
for (const s of sectionsArr || []) sec[s.section_key] = s;

const head     = sec['doneaza_head']     || {};
const side     = sec['doneaza_side']     || {};
const redirect = sec['doneaza_redirect'] || {};
const transfer = sec['doneaza_transfer'] || {};
const amounts  = sec['doneaza_amounts']  || {};

const { data: ciRows } = await supabase.from('contact_info').select('key,value');
const ci: Record<string,string> = {};
for (const r of ciRows || []) ci[r.key] = r.value || '';

const presetAmounts = [
  { amt: 50,  numKey: 'stat1_num', labelKey: 'stat1_label' },
  { amt: 100, numKey: 'stat2_num', labelKey: 'stat2_label' },
  { amt: 200, numKey: 'stat3_num', labelKey: 'stat3_label' },
  { amt: 500, numKey: 'stat4_num', labelKey: 'stat4_label' },
];

const defaults: Record<string,string> = {
  stat1_label: 'rechizite 1 copil',
  stat2_label: 'masă caldă 1 lună',
  stat3_label: 'transport școlar',
  stat4_label: 'set complet de școală',
};
---

<Layout
  title="Donează — Educația Schimbă Destine"
  description="Donează prin card sau redirecționează 3,5% din impozit. 100% din donație merge direct către copiii sprijiniți de asociație."
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow"
        data-db-table="page_sections" data-db-id={head.id} data-db-field="eyebrow"
      >{head.eyebrow || 'Donează'}</span>
      <h1
        data-db-table="page_sections" data-db-id={head.id} data-db-field="heading"
      >{head.heading || 'Transformă o viață cu o donație.'}</h1>
      <p
        data-db-table="page_sections" data-db-id={head.id} data-db-field="subheading"
      >{head.subheading || 'Donație unică sau lunară, prin card. 100% din donație merge direct către copiii sprijiniți.'}</p>
    </div>
  </section>

  <section class="tight">
    <div class="container">
      <div class="donate-panel">
        <div class="donate-options">
          <div class="donate-tabs" role="tablist">
            <button class="donate-tab active" data-mode="payment" type="button">Donație unică</button>
            <button class="donate-tab" data-mode="subscription" type="button">Donație lunară</button>
          </div>

          <div class="amounts">
            {presetAmounts.map(({ amt, numKey, labelKey }, i) => (
              <button
                class={`amount ${i === 1 ? 'active' : ''}`}
                data-amount={amounts[numKey] || amt}
                type="button"
              >
                {amounts[numKey] || amt} RON
                <small
                  data-db-table="page_sections" data-db-id={amounts.id} data-db-field={labelKey}
                >{amounts[labelKey] || defaults[labelKey]}</small>
              </button>
            ))}
          </div>

          <div class="form-field" style="margin-bottom:16px">
            <label for="custom-amount">Sau introdu suma dorită (RON)</label>
            <input id="custom-amount" type="number" min="5" step="1" placeholder="ex. 75">
          </div>

          <div class="form-field">
            <label for="donor-email">Email (pentru chitanță)</label>
            <input id="donor-email" type="email" placeholder="adresa.ta@email.ro" required>
          </div>

          <div class="impact-note">
            🛡️ Plata se face securizat prin Stripe. Nu stocăm datele cardului tău.
          </div>

          <button id="donate-btn" class="btn btn-primary" type="button" style="width:100%;justify-content:center">
            Continuă spre plată →
          </button>
          <p id="donate-error" style="color:#a04a1f;font-size:0.88rem;margin-top:12px;display:none"></p>
        </div>

        <div class="donate-side">
          <h3
            data-db-table="page_sections" data-db-id={side.id} data-db-field="heading"
          >{side.heading || 'De ce donezi?'}</h3>
          <ul>
            {(side.stat1_label ?? '100% din donație merge direct către copii.').trim() && <li data-db-table="page_sections" data-db-id={side.id} data-db-field="stat1_label">{side.stat1_label || '100% din donație merge direct către copii.'}</li>}
            {(side.stat2_label ?? 'Primești chitanță pe email pentru deducerea fiscală.').trim() && <li data-db-table="page_sections" data-db-id={side.id} data-db-field="stat2_label">{side.stat2_label || 'Primești chitanță pe email pentru deducerea fiscală.'}</li>}
            {(side.stat3_label ?? 'Donație lunară = sprijin predictibil pentru burse și hub.').trim() && <li data-db-table="page_sections" data-db-id={side.id} data-db-field="stat3_label">{side.stat3_label || 'Donație lunară = sprijin predictibil pentru burse și hub.'}</li>}
            {(side.stat4_label ?? 'Te poți opri oricând, din contul tău Stripe.').trim() && <li data-db-table="page_sections" data-db-id={side.id} data-db-field="stat4_label">{side.stat4_label || 'Te poți opri oricând, din contul tău Stripe.'}</li>}
          </ul>

          <h3 style="margin-top:32px" id="redirect"
            data-db-table="page_sections" data-db-id={redirect.id} data-db-field="heading"
          >{redirect.heading || 'Redirect 3,5% impozit'}</h3>
          <p
            data-db-table="page_sections" data-db-id={redirect.id} data-db-field="subheading"
          >{redirect.subheading || 'Dacă ești salariat, poți redirecționa 3,5% din impozitul pe venit către asociație, fără niciun cost.'}</p>
          <a href={redirect.cta_primary_link || 'https://formular230.ro/asociatia-educatia-schimba-destine'}
            target="_blank" rel="noopener" class="btn btn-ghost btn-sm"
            data-db-table="page_sections" data-db-id={redirect.id} data-db-field="cta_primary_text"
          >{redirect.cta_primary_text || 'Completează formularul 230 →'}</a>

          <h3 style="margin-top:32px" id="transfer"
            data-db-table="page_sections" data-db-id={transfer.id} data-db-field="heading"
          >{transfer.heading || 'Transfer bancar'}</h3>
          <p>
            <strong>Asociația Educația Schimbă Destine</strong><br>
            CIF: {ci.cif || '49395736'}<br>
            <span class="iban">{ci.iban || 'RO30 RZBR 0000 0600 2578 2550'}</span><br>
            <small
              data-db-table="page_sections" data-db-id={transfer.id} data-db-field="subheading"
            >{transfer.subheading || 'Raiffeisen Bank · București'}</small>
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    let mode: 'payment' | 'subscription' = 'payment';
    let amount = 100;

    const tabs = document.querySelectorAll<HTMLButtonElement>('.donate-tab');
    const amountBtns = document.querySelectorAll<HTMLButtonElement>('.amount');
    const customInput = document.getElementById('custom-amount') as HTMLInputElement;
    const emailInput = document.getElementById('donor-email') as HTMLInputElement;
    const btn = document.getElementById('donate-btn') as HTMLButtonElement;
    const errorEl = document.getElementById('donate-error') as HTMLParagraphElement;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        mode = tab.dataset.mode as 'payment' | 'subscription';
      });
    });

    amountBtns.forEach(a => {
      a.addEventListener('click', () => {
        amountBtns.forEach(x => x.classList.remove('active'));
        a.classList.add('active');
        amount = Number(a.dataset.amount);
        customInput.value = '';
      });
    });

    customInput.addEventListener('input', () => {
      const val = Number(customInput.value);
      if (val > 0) {
        amountBtns.forEach(x => x.classList.remove('active'));
        amount = val;
      }
    });

    btn.addEventListener('click', async () => {
      errorEl.style.display = 'none';
      const email = emailInput.value.trim();
      if (!email || !email.includes('@')) {
        errorEl.textContent = 'Te rugăm să introduci un email valid pentru chitanță.';
        errorEl.style.display = 'block';
        return;
      }
      if (amount < 5) {
        errorEl.textContent = 'Suma minimă este 5 RON.';
        errorEl.style.display = 'block';
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Te redirecționăm către plată...';
      try {
        const res = await fetch('/api/create-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, mode, email }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Eroare la inițializarea plății.');
        window.location.href = data.url;
      } catch (err: any) {
        errorEl.textContent = err.message || 'Eroare necunoscută. Te rugăm să încerci din nou.';
        errorEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Continuă spre plată →';
      }
    });
  </script>
</Layout>